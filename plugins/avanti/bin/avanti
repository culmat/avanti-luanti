#!/usr/bin/env bash
# avanti: command-line companion of the avanti Claude Code plugin (avanti-luanti).
# Scaffolds Luanti mods and tests them headlessly across games and engine versions.
set -euo pipefail

AVANTI_LIB="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib" && pwd)"
# shellcheck source=../lib/common.sh
source "$AVANTI_LIB/common.sh"

usage() {
	cat <<EOF
avanti: build and test Luanti mods (part of avanti-luanti)

Usage:
  avanti doctor [--quiet]            Check tools, games, database and search index
  avanti games sync [ID...]          Clone or update reference games (default: all)
  avanti games list                  Show reference games and whether they are synced
  avanti corpus sync [--top N]       Engine docs + games + vendored references + top-N package
                                     sources into \$AVANTI_HOME/corpus, then index them for search
  avanti new NAME [options]          Scaffold a mod from the template (see avanti new --help)
  avanti test [PATH] [options]       Lint, then run PATH headlessly in each game x engine
  avanti serve [PATH] --game ID      Run a local server with the mod for play-testing
  avanti screenshot [PATH]           In-game screenshots from a shot list (macOS, Luanti app)
  avanti screenshot --record --game ID   Fly around and save viewpoints with /shot <name>
  avanti index [PATH]                (Re)build the zvec-grep index (default: the corpus, via a
                                     text-only mirror in \$AVANTI_HOME/search)
  avanti cdb status [PATH|AUTHOR/NAME]   ContentDB state, latest release, game support (read-only)
  avanti cdb release REF [PATH]      Create a ContentDB release from a pushed tag and wait for the
                                     import (needs CONTENTDB_TOKEN; not needed with a webhook)
  avanti env                        Print the environment avanti uses

Environment: AVANTI_HOME=$AVANTI_HOME (ldg uses its own LDG_HOME)
EOF
}

# ---------------------------------------------------------------- doctor

cmd_doctor() {
	local quiet=0 problems=0
	[[ "${1:-}" == "--quiet" ]] && quiet=1
	row() { # row <ok|warn|fail> <name> <detail>
		local mark
		case "$1" in
		ok) mark="${C_GREEN}ok  ${C_OFF}" ;;
		warn) mark="${C_YELLOW}warn${C_OFF}" ;;
		*) mark="${C_RED}FAIL${C_OFF}" ;;
		esac
		[[ "$1" == ok ]] || problems=$((problems + 1))
		if [[ $quiet -eq 0 || "$1" != ok ]]; then
			printf '%s  %-22s %s\n' "$mark" "$2" "$3"
		fi
	}
	tool() { # tool <name> <ok|warn severity if missing> <hint> [version cmd]
		if have "$1"; then
			row ok "$1" "$(eval "${4:-$1 --version}" 2>&1 | head -1)"
		else
			row "$2" "$1" "missing: $3"
		fi
	}
	tool git fail "install git"
	tool jq fail "brew install jq / apt install jq"
	tool uv fail "https://docs.astral.sh/uv/"
	tool ldg fail "uv tool install git+https://github.com/culmat/luanti-depgraph" "ldg version"
	if have luacheck && ! luacheck --version >/dev/null 2>&1; then
		row warn luacheck "installed but broken (Lua 5.5?): luarocks --lua-version=5.1 --lua-dir=\"\$(brew --prefix luajit)\" install --local luacheck"
	else
		tool luacheck warn "luarocks --lua-version=5.1 install --local luacheck"
	fi
	tool stylua warn "brew install stylua / cargo install stylua"
	tool lua-language-server warn "brew install lua-language-server"
	tool zg warn "npm i -g @zvec/zvec-grep (Node 22+)" "zg --version"

	local bin
	if bin="$(luanti_bin)"; then
		row ok "luanti (native)" "$(luanti_version "$bin") at $bin"
	else
		row warn "luanti (native)" "not found: brew install --cask luanti, or set LUANTI_BIN"
	fi
	if docker_ready; then
		row ok "docker" "daemon running"
	elif have docker; then
		row warn "docker" "installed but daemon not running (colima start / start Docker Desktop)"
	else
		row warn "docker" "missing: only needed for the multi-engine matrix and CI parity"
	fi

	local id dir
	while IFS=$'\t' read -r id _ _; do
		dir="$(game_dir "$id")"
		if [[ -n "$dir" ]]; then
			row ok "game $id" "$dir"
		else
			row warn "game $id" "not synced: avanti games sync $id"
		fi
	done < <(games_table)

	if have ldg; then
		local age
		if age="$(ldg info --json 2>/dev/null | jq -r '.age_days')"; then
			if awk -v a="$age" 'BEGIN { exit !(a > 7) }'; then
				row warn "dependency db" "$age days old: ldg update"
			else
				row ok "dependency db" "$age days old"
			fi
		else
			row fail "dependency db" "missing: ldg update"
		fi
	fi
	local code_db
	code_db="$(ldg info --json 2>/dev/null | jq -r '.path // empty' | sed 's/luanti-deps.sqlite$/luanti-code.sqlite/')"
	if [[ -n "$code_db" && -f "$code_db" ]]; then
		row ok "code search index" "$code_db"
	else
		row warn "code search index" "missing: ldg code update (needs luanti-depgraph[search])"
	fi
	if [[ -d "$AVANTI_SEARCH/.zvec-grep" ]]; then
		row ok "search index" "$AVANTI_SEARCH"
	else
		row warn "search index" "missing: avanti index"
	fi
	if [[ -d "$AVANTI_VENDOR/luanti-ide-helper" ]]; then
		row ok "LuaLS annotations" "$AVANTI_VENDOR/luanti-ide-helper"
	else
		row warn "LuaLS annotations" "missing: avanti corpus sync"
	fi
	if [[ -n "${CONTENTDB_TOKEN:+set}" ]]; then
		row ok "CONTENTDB_TOKEN" "set"
	elif [[ $quiet -eq 0 ]]; then
		note "      CONTENTDB_TOKEN        not set (only needed for avanti cdb release without a webhook)"
	fi
	if [[ $quiet -eq 1 && $problems -gt 0 ]]; then
		info "avanti doctor: $problems problem(s); run ./setup.sh or the hints above."
	elif [[ $quiet -eq 0 ]]; then
		info "$problems problem(s)"
	fi
	return 0
}

# ---------------------------------------------------------------- games & corpus

shallow_sync() { # shallow_sync <url> <dir>
	local url="$1" dir="$2"
	if [[ -d "$dir/.git" ]]; then
		note "updating $dir"
		git -C "$dir" fetch --quiet --depth 1 origin HEAD
		git -C "$dir" reset --quiet --hard FETCH_HEAD
	else
		note "cloning $url"
		mkdir -p "$(dirname "$dir")"
		git clone --quiet --depth 1 "$url" "$dir"
	fi
}

engine_sync() {
	local tag="$AVANTI_ENGINE_VERSION"
	if [[ -d "$AVANTI_ENGINE_SRC/.git" ]] &&
		[[ "$(git -C "$AVANTI_ENGINE_SRC" describe --tags 2>/dev/null)" == "$tag" ]]; then
		return 0
	fi
	note "fetching engine $tag (doc/, builtin/, games/devtest)"
	rm -rf "$AVANTI_ENGINE_SRC"
	mkdir -p "$AVANTI_CORPUS"
	git -c advice.detachedHead=false clone --quiet --depth 1 --branch "$tag" --filter=blob:none --sparse \
		https://github.com/luanti-org/luanti.git "$AVANTI_ENGINE_SRC"
	git -C "$AVANTI_ENGINE_SRC" sparse-checkout set doc builtin games/devtest
}

cmd_games() {
	local sub="${1:-list}"
	shift || true
	case "$sub" in
	list)
		local id folder source dir
		while IFS=$'\t' read -r id folder source; do
			dir="$(game_dir "$id")"
			printf '%-12s %-14s %s\n' "$id" "${dir:+synced}" "${dir:-$source}"
		done < <(games_table)
		;;
	sync)
		local wanted=("$@") id folder source
		while IFS=$'\t' read -r id folder source; do
			if [[ ${#wanted[@]} -gt 0 ]] && [[ ! " ${wanted[*]} " =~ \ ($id|$folder)\  ]]; then
				continue
			fi
			if [[ "$source" == engine:* ]]; then
				engine_sync
			else
				shallow_sync "$source" "$AVANTI_GAMES/$folder"
			fi
		done < <(games_table)
		cmd_games list
		;;
	*) die "unknown: avanti games $sub" ;;
	esac
}

cmd_corpus() {
	local top=300
	[[ "${1:-}" == "--top" ]] && top="${2:?--top needs a number}"
	engine_sync
	cmd_games sync
	shallow_sync https://github.com/Voxrame/luanti-ide-helper.git "$AVANTI_VENDOR/luanti-ide-helper"
	shallow_sync https://gitlab.com/rubenwardy/minetest_modding_book.git "$AVANTI_VENDOR/modding_book"
	shallow_sync https://github.com/BuckarooBanzay/mtt.git "$AVANTI_VENDOR/mtt"
	if [[ "$top" -gt 0 ]]; then
		note "fetching sources of the top $top packages (ldg fetch --git-top $top)"
		LDG_CORPUS="$AVANTI_PACKAGES" ldg fetch --git-top "$top"
	fi
	cmd_index
}

# zvec-grep silently skips git repositories nested below the index root, and the corpus is
# a set of git checkouts, so search runs on a text-only mirror without .git.
search_mirror() {
	note "mirroring text sources of $AVANTI_CORPUS into $AVANTI_SEARCH"
	mkdir -p "$AVANTI_SEARCH"
	rsync -a --delete --prune-empty-dirs \
		--exclude='.git/' --exclude='.zvec-grep/' --exclude='.ldg-release' \
		--include='*/' --include='*.lua' --include='*.md' --include='*.txt' --include='*.conf' \
		--include='*.tr' --include='*.po' --include='*.json' --include='*.yml' --include='*.luacheckrc' \
		--exclude='*' "$AVANTI_CORPUS/" "$AVANTI_SEARCH/"
}

cmd_index() {
	local path="${1:-}"
	have zg || die "zvec-grep is not installed: npm i -g @zvec/zvec-grep"
	if [[ -z "$path" ]]; then
		search_mirror
		path="$AVANTI_SEARCH"
	fi
	note "indexing $path (local embeddings; the first run downloads the model)"
	if [[ -d "$path/.zvec-grep" ]]; then
		zg index "$path" # incremental; reuses the stored embedding model
	else
		zg index "$path" --embedding "${AVANTI_EMBEDDING:-local/potion-code-16m-v2}"
	fi
}

# ---------------------------------------------------------------- new

new_usage() {
	cat <<'EOF'
Usage: avanti new NAME [--dir DIR] [--title T] [--description D] [--games g1,g2]
                       [--license MIT|LGPL-2.1-or-later] [--owner GITHUB_OWNER]
                       [--author CONTENTDB_USER] [--ai NONE|ASSISTED|GENERATED] [--force]
EOF
}

cmd_new() {
	local name="" dir="." title="" description="" games="minetest,mineclonia,mineclone2"
	local license="MIT" owner="${AVANTI_GITHUB_OWNER:-}" author="${AVANTI_CONTENTDB_USER:-}"
	local ai="ASSISTED" force=0
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--dir) dir="$2"; shift 2 ;;
		--title) title="$2"; shift 2 ;;
		--description) description="$2"; shift 2 ;;
		--games) games="$2"; shift 2 ;;
		--license) license="$2"; shift 2 ;;
		--owner) owner="$2"; shift 2 ;;
		--author) author="$2"; shift 2 ;;
		--ai) ai="$2"; shift 2 ;;
		--force) force=1; shift ;;
		-h | --help) new_usage; return 0 ;;
		-*) die "unknown option $1" ;;
		*) name="$1"; shift ;;
		esac
	done
	[[ -n "$name" ]] || { new_usage; exit 1; }
	[[ "$name" =~ ^[a-z0-9_]+$ ]] || die "mod names may only contain a-z, 0-9 and _"
	[[ "$ai" =~ ^(NONE|ASSISTED|GENERATED)$ ]] || die "--ai must be NONE, ASSISTED or GENERATED"
	[[ "$license" =~ ^(MIT|LGPL-2.1-or-later)$ ]] || die "--license must be MIT or LGPL-2.1-or-later"
	[[ -n "$owner" ]] || owner="$(gh api user --jq .login 2>/dev/null || echo YOUR_GITHUB_USER)"
	[[ -n "$title" ]] || title="$(tr '_' ' ' <<<"$name" | awk '{ for (i = 1; i <= NF; i++) $i = toupper(substr($i, 1, 1)) substr($i, 2) } 1')"
	[[ -n "$description" ]] || description="TODO: one sentence describing $title."

	if have ldg; then
		local check
		check="$(ldg name-check "$name" ${author:+--author "$author"} --json 2>/dev/null || true)"
		if [[ "$(jq -r '.available // empty' <<<"$check")" == "false" ]]; then
			local taken
			taken="$(jq -r '.used_by | join(", ")' <<<"$check")"
			[[ $force -eq 1 ]] || die "'$name' is already used on ContentDB by $taken (policy 3.1). Pick another name or pass --force for a fork/drop-in replacement."
			warn "'$name' is used by $taken; continuing because of --force"
		fi
	else
		warn "ldg not installed: skipping the ContentDB name check"
	fi

	local target="$dir/$name"
	[[ ! -e "$target" ]] || die "$target already exists"
	mkdir -p "$target"
	cp -R "$AVANTI_PLUGIN_ROOT/templates/mod/." "$target/"

	local supported year games_yaml
	supported="${games//,/, }"
	year="$(date +%Y)"
	games_yaml="$games"
	local file
	while IFS= read -r -d '' file; do
		NAME="$name" TITLE="$title" DESCRIPTION="$description" SUPPORTED="$supported" \
			LICENSE_ID="$license" OWNER="$owner" YEAR="$year" AI="$ai" GAMES="$games_yaml" \
			perl -0pi -e '
				s/\{\{modname\}\}/$ENV{NAME}/g; s/\{\{title\}\}/$ENV{TITLE}/g;
				s/\{\{description\}\}/$ENV{DESCRIPTION}/g; s/\{\{supported_games\}\}/$ENV{SUPPORTED}/g;
				s/\{\{license\}\}/$ENV{LICENSE_ID}/g; s/\{\{owner\}\}/$ENV{OWNER}/g;
				s/\{\{year\}\}/$ENV{YEAR}/g; s/\{\{ai_disclosure\}\}/$ENV{AI}/g; s/\{\{games\}\}/$ENV{GAMES}/g;
			' "$file"
	done < <(find "$target" -type f -print0)

	if [[ "$license" == "LGPL-2.1-or-later" ]]; then
		local lgpl
		lgpl="$(curl -fsSL https://www.gnu.org/licenses/old-licenses/lgpl-2.1.txt)" || die "could not download the LGPL text"
		perl -0pi -e 'BEGIN { $t = shift } s/<<CODE_LICENSE_TEXT>>.*?<<END_CODE_LICENSE_TEXT>>/$t/s' "$lgpl" "$target/LICENSE"
	else
		perl -0pi -e 's/<<CODE_LICENSE_TEXT>>\n//; s/<<END_CODE_LICENSE_TEXT>>\n//' "$target/LICENSE"
	fi

	if [[ -d "$AVANTI_VENDOR/luanti-ide-helper" ]]; then
		jq -n --arg lib "$AVANTI_VENDOR/luanti-ide-helper" '{
			"$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
			"runtime.version": "LuaJIT", "workspace.library": [$lib],
			"workspace.checkThirdParty": false, "diagnostics.globals": ["mtt"]
		}' >"$target/.luarc.json"
	fi
	git -C "$target" init --quiet -b main
	info "${C_GREEN}created${C_OFF} $target"
	note "next: cd $target && avanti test"
}

# ---------------------------------------------------------------- test

test_usage() {
	cat <<'EOF'
Usage: avanti test [PATH] [--game ID]... [--engine VERSION]... [--runner auto|native|docker]
                   [--timeout SECONDS] [--keep] [--no-lint] [--fixed-order] [--json]

Lints PATH (luacheck, stylua, ldg lint), then for every game x engine builds a throwaway
world with PATH, the dependencies `ldg install` resolves for that game and a smoke-test
mod (or mtt, if the mod uses it), runs the server headlessly with random_mod_load_order,
and reports errors from the log. Only errors that mention the mod fail the run; errors from
the game or other mods are reported as WARN, a game that can't start on that engine as BROKEN,
and engines below the game's min_minetest_version are skipped. Games default to supported_games in mod.conf/modpack.conf,
else minetest,mineclonia,mineclone2.
EOF
}

# Supported games declared by the package, mapped to our reference game ids.
declared_games() {
	local conf value
	for conf in mod.conf modpack.conf; do
		[[ -f "$1/$conf" ]] || continue
		value="$(awk -F'=' '/^[[:space:]]*supported_games[[:space:]]*=/ { print $2 }' "$1/$conf" | tr -d ' ')"
		[[ -n "$value" && "$value" != "*" ]] && tr ',' '\n' <<<"$value" | sed 's/_game$//' && return 0
	done
	return 0
}

lint_step() { # lint_step <path>; returns non-zero on blocking problems
	local path="$1" failed=0
	if have luacheck; then
		note "luacheck"
		(cd "$path" && luacheck --no-color -q .) || failed=1
	else
		warn "luacheck not installed, skipping"
	fi
	if [[ -f "$path/.stylua.toml" || -f "$path/stylua.toml" ]]; then
		if have stylua; then
			note "stylua --check"
			stylua --check "$path" >/dev/null || { warn "stylua: formatting differs (run: stylua $path)"; failed=1; }
		fi
	fi
	note "ldg lint"
	ldg lint "$path" --quick --strict || failed=1
	return $failed
}

# run_case <path> <game> <engine> <runner> <timeout> <keep> -> appends a JSON line to $RESULTS
run_case() {
	local path="$1" game="$2" engine="$3" runner="$4" limit="$5" keep="$6"
	local id folder gdir run started status="FAIL" reason="" code=0 uses_mtt=0
	id="$(game_id "$game")"
	folder="$(game_field "$game" 2)"
	gdir="$(game_dir "$game")"
	run="$(mktemp -d "${TMPDIR:-/tmp}/avanti-test.XXXXXX")"
	mkdir -p "$run/mods" "$run/world" "$run/user"
	started=$(date +%s)

	record() {
		# Errors that mention the mod under test (mod names, item prefixes, its folder) are
		# ours; everything else comes from the game or other mods and only warrants a warning.
		local log="$run/debug.txt" pattern="$TARGET_PATTERN"
		grep -E 'ERROR\[|ModError|Runtime error|stack traceback' "$log" 2>/dev/null |
			sed -E 's/^[0-9: -]+//' | awk '!seen[$0]++' >"$run/errors.all" || true
		grep -E "$pattern" "$run/errors.all" >"$run/errors.ours" || true
		grep -vE "$pattern" "$run/errors.all" >"$run/errors.other" || true
		grep -E 'ndeclared global|deprecated' "$log" 2>/dev/null | sed -E 's/^[0-9: -]+//' |
			awk '!seen[$0]++' | grep -E "$pattern" >"$run/warnings.ours" || true
		if [[ "$status" == PASS && -s "$run/errors.other" ]]; then
			status="WARN"
			reason="$(wc -l <"$run/errors.other" | tr -d ' ') error(s) from the game or other mods"
		fi
		jq -cn --arg game "$game" --arg engine "$engine" --arg runner "$runner" --arg status "$status" \
			--arg reason "$reason" --arg log "$log" --argjson seconds "$(($(date +%s) - started))" \
			--rawfile errors "$run/errors.ours" --rawfile other "$run/errors.other" \
			--rawfile warnings "$run/warnings.ours" \
			'def lines: split("\n") | map(select(length > 0)) | .[:15];
			{game: $game, engine: $engine, runner: $runner, status: $status, reason: $reason,
			 seconds: $seconds, errors: ($errors | lines), other_errors: ($other | lines),
			 warnings: ($warnings | lines), log: $log}' >>"$RESULTS"
		if [[ "$status" =~ ^(PASS|WARN|SKIP|BROKEN)$ && "$keep" -eq 0 ]]; then rm -rf "$run"; fi
	}

	if [[ -z "$gdir" ]]; then
		reason="game not synced (avanti games sync $game)"
		status="SKIP"
		record
		return 0
	fi

	local game_min
	game_min="$(awk -F'=' '/^[[:space:]]*min_minetest_version[[:space:]]*=/ { gsub(/[[:space:]]/, "", $2); print $2 }' "$gdir/game.conf" 2>/dev/null)"
	if [[ -n "$game_min" && "$engine" != master ]] && version_lt "$engine" "$game_min"; then
		reason="$game folder requires Luanti >= $game_min"
		status="SKIP"
		record
		return 0
	fi

	# The package under test, in a folder named like the mod (CI checkouts may use any name).
	rsync -a --exclude .git --exclude .github "$path/" "$run/mods/$PKG_FOLDER/" 2>/dev/null ||
		cp -R "$path" "$run/mods/$PKG_FOLDER"
	grep -qsE '^[[:space:]]*(optional_)?depends[[:space:]]*=.*\<mtt\>' "$path"/mod.conf "$path"/*/mod.conf && uses_mtt=1
	# Test helpers a mod declares (optionally) are installed too: mtt runs the tests,
	# fakelib provides fake players for them.
	local helpers="" helper
	for helper in mtt fakelib; do
		grep -qsE "^[[:space:]]*(optional_)?depends[[:space:]]*=.*\<$helper\>" "$path"/mod.conf "$path"/*/mod.conf &&
			helpers="${helpers:+$helpers,}$helper"
	done
	local extra=()
	[[ -n "$helpers" ]] && extra=(--with "$helpers")

	# Dependencies the game doesn't provide, resolved and fetched by ldg.
	local install_json
	if ! install_json="$(ldg install "$path" --game "$game" --dest "$run/mods" \
		${extra[@]+"${extra[@]}"} --json 2>"$run/ldg.err")"; then
		reason="dependencies can't be met in $game: $(jq -r '[.resolution.missing[]?.modname] | join(", ")' <<<"$install_json" 2>/dev/null || cat "$run/ldg.err")"
		record
		return 0
	fi
	cp -R "$AVANTI_LIB/avanti_smoke" "$run/mods/"

	{
		echo "gameid = $id"
		echo "backend = sqlite3"
		echo "player_backend = sqlite3"
		echo "auth_backend = sqlite3"
		echo "mod_storage_backend = sqlite3"
		echo "load_mod_avanti_smoke = true"
		jq -r '.enable[] | "load_mod_\(.) = true"' <<<"$install_json"
	} >"$run/world/world.mt"
	{
		echo "random_mod_load_order = $([[ "${FIXED_ORDER:-0}" -eq 1 ]] && echo false || echo true)"
		echo "server_announce = false"
		echo "ipv6_server = false"
		echo "bind_address = 127.0.0.1"
		echo "debug_log_level = action"
		echo "deprecated_lua_api_handling = log"
		if [[ $uses_mtt -eq 1 ]]; then
			echo "mtt_enable = true"
			echo "mtt_filter = ${TARGET_MODS// /,}"
		else
			echo "avanti_smoke = true"
		fi
	} >"$run/test.conf"

	local port=$((30000 + RANDOM % 5000))
	set +e
	if [[ "$runner" == native ]]; then
		local bin
		bin="$(luanti_bin)" || die "no native Luanti binary (brew install --cask luanti, or --runner docker)"
		LUANTI_GAME_PATH="$(dirname "$gdir")" MINETEST_GAME_PATH="$(dirname "$gdir")" \
			LUANTI_MOD_PATH="$run/mods" MINETEST_MOD_PATH="$run/mods" \
			LUANTI_USER_PATH="$run/user" MINETEST_USER_PATH="$run/user" \
			run_with_timeout "$limit" "$bin" --server --world "$run/world" --gameid "$id" \
			--config "$run/test.conf" --logfile "$run/debug.txt" --port "$port" >"$run/stdout.txt" 2>&1
		code=$?
	else
		docker_ready || die "docker daemon not running (colima start / Docker Desktop), or use --runner native"
		# shellcheck disable=SC2016  # $@ expands inside the container's sh
		run_with_timeout "$limit" docker run --rm --user "$(id -u):$(id -g)" \
			-v "$run:/avanti" -v "$gdir:/games/$folder:ro" \
			-e LUANTI_GAME_PATH=/games -e MINETEST_GAME_PATH=/games \
			-e LUANTI_MOD_PATH=/avanti/mods -e MINETEST_MOD_PATH=/avanti/mods \
			-e LUANTI_USER_PATH=/avanti/user -e MINETEST_USER_PATH=/avanti/user -e HOME=/avanti/user \
			--entrypoint sh "$(engine_image "$engine")" \
			-c 'exec "$(command -v luantiserver || command -v minetestserver)" "$@"' sh \
			--world /avanti/world --gameid "$id" --config /avanti/test.conf \
			--logfile /avanti/debug.txt --port 30000 >"$run/stdout.txt" 2>&1
		code=$?
	fi
	set -e

	local ours
	ours="$(grep -E 'ERROR\[|ModError|Runtime error' "$run/debug.txt" 2>/dev/null |
		grep -cE "$TARGET_PATTERN" || true)"
	if [[ $code -eq 124 || $code -eq 142 ]]; then
		reason="timed out after ${limit}s"
	elif [[ $code -ne 0 && "${ours:-0}" -eq 0 ]] && grep -qE "ERROR\[.*(/games/$folder/|/games/[^/]+/mods/)" "$run/debug.txt" 2>/dev/null; then
		# The game itself failed (e.g. it doesn't support this engine version): not the mod's fault.
		status="BROKEN"
		reason="the game failed to start on $engine (errors only in the game's own files)"
	elif [[ $code -ne 0 ]]; then
		reason="server exited with code $code"
		[[ "${ours:-0}" -eq 0 ]] && reason="$reason; no error names your mod (game load-order issue? retry or use --fixed-order)"
	elif [[ "${ours:-0}" -gt 0 ]]; then
		reason="errors from your mod in the log"
	elif [[ $uses_mtt -eq 0 ]] && ! grep -q '\[avanti_smoke\] OK' "$run/debug.txt" 2>/dev/null; then
		reason="smoke test did not complete"
	else
		status="PASS"
	fi
	record
}

cmd_test() {
	local path="." runner="auto" limit=240 keep=0 lint=1 json=0
	local games=() engines=()
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--game) games+=("$2"); shift 2 ;;
		--engine) engines+=("$2"); shift 2 ;;
		--runner) runner="$2"; shift 2 ;;
		--timeout) limit="$2"; shift 2 ;;
		--keep) keep=1; shift ;;
		--no-lint) lint=0; shift ;;
		--fixed-order) FIXED_ORDER=1; shift ;;
		--json) json=1; shift ;;
		-h | --help) test_usage; return 0 ;;
		-*) die "unknown option $1" ;;
		*) path="$1"; shift ;;
		esac
	done
	path="$(cd "$path" && pwd)"
	have ldg || die "ldg is required: uv tool install git+https://github.com/culmat/luanti-depgraph"
	have jq || die "jq is required"
	TARGET_MODS="$(ldg deps "$path" --json | jq -r '.provides | join(" ")')"
	[[ -n "$TARGET_MODS" ]] || die "no mods found in $path"
	PKG_FOLDER="$(basename "$path")"
	if [[ -f "$path/init.lua" && "$TARGET_MODS" != *" "* ]]; then PKG_FOLDER="$TARGET_MODS"; fi
	# Matches log lines that name one of the target's mods (also as item prefix) or its folder.
	TARGET_PATTERN="(^|[^a-z0-9_])(${TARGET_MODS// /|})([^a-z0-9_]|\$)|/mods/$PKG_FOLDER/"

	if [[ ${#games[@]} -eq 0 ]]; then
		while IFS= read -r g; do games+=("$g"); done < <(declared_games "$path")
		[[ ${#games[@]} -gt 0 ]] || games=(minetest mineclonia mineclone2)
	fi
	if [[ "$runner" == auto ]]; then
		if [[ ${#engines[@]} -gt 0 ]] && docker_ready; then runner=docker
		elif luanti_bin >/dev/null; then runner=native
		elif docker_ready; then runner=docker
		else die "need a native Luanti (brew install --cask luanti) or a running docker daemon"
		fi
	fi
	if [[ ${#engines[@]} -eq 0 ]]; then
		if [[ "$runner" == native ]]; then engines=("$(luanti_version "$(luanti_bin)")")
		else engines=("$AVANTI_ENGINE_VERSION")
		fi
	fi

	local lint_ok=1
	if [[ $lint -eq 1 ]]; then
		lint_step "$path" || lint_ok=0
	fi

	RESULTS="$(mktemp)"
	local g e
	for g in "${games[@]}"; do
		for e in "${engines[@]}"; do
			note "running $(basename "$path") in $g on $e ($runner)"
			run_case "$path" "$g" "$e" "$runner" "$limit" "$keep"
		done
	done

	local failed
	failed="$(jq -s '[.[] | select(.status == "FAIL")] | length' "$RESULTS")"
	if [[ $json -eq 1 ]]; then
		jq -s --argjson lint "$lint_ok" '{lint_ok: ($lint == 1), results: .}' "$RESULTS"
	else
		printf '\n%-12s %-9s %-7s %-6s %s\n' GAME ENGINE RUNNER STATUS DETAIL
		jq -r '[.game, .engine, .runner, .status, (.reason + (if .seconds > 0 then " (\(.seconds)s)" else "" end))] | @tsv' "$RESULTS" |
			while IFS=$'\t' read -r g e r s d; do
				local color="$C_GREEN"
				[[ "$s" == FAIL ]] && color="$C_RED"
				[[ "$s" == SKIP || "$s" == WARN || "$s" == BROKEN ]] && color="$C_YELLOW"
				printf '%-12s %-9s %-7s %s%-6s%s %s\n' "$g" "$e" "$r" "$color" "$s" "$C_OFF" "$d"
			done
		jq -r 'select(.status == "FAIL" or .status == "WARN" or .status == "BROKEN") | "\n\(.game) \(.engine): \(.log)",
			(.errors[] | "  " + .), (.warnings[] | "  warning: " + .),
			(.other_errors[:5][] | "  other: " + .)' "$RESULTS"
		[[ $lint_ok -eq 1 ]] || printf '\n%slint failed%s (see above)\n' "$C_RED" "$C_OFF"
	fi
	rm -f "$RESULTS"
	[[ "$failed" -eq 0 && $lint_ok -eq 1 ]]
}

# ---------------------------------------------------------------- serve

cmd_serve() {
	local path="." game="" port=30000
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--game) game="$2"; shift 2 ;;
		--port) port="$2"; shift 2 ;;
		-*) die "unknown option $1" ;;
		*) path="$1"; shift ;;
		esac
	done
	[[ -n "$game" ]] || die "avanti serve [PATH] --game ID"
	path="$(cd "$path" && pwd)"
	local gdir id world mods bin
	gdir="$(game_dir "$game")"
	[[ -n "$gdir" ]] || die "game $game not synced: avanti games sync $game"
	id="$(game_id "$game")"
	bin="$(luanti_bin)" || die "no native Luanti binary"
	world="$AVANTI_HOME/worlds/$(basename "$path")-$id"
	mods="$world/.avanti-mods"
	mkdir -p "$mods"
	rsync -a --delete --exclude .git "$path/" "$mods/$(basename "$path")/"
	local install_json
	install_json="$(ldg install "$path" --game "$game" --dest "$mods" --json)" ||
		die "dependencies can't be met in $game (ldg resolve $path --game $game)"
	if [[ ! -f "$world/world.mt" ]]; then
		echo "gameid = $id" >"$world/world.mt"
		echo "backend = sqlite3" >>"$world/world.mt"
	fi
	sed -i.bak '/^load_mod_/d' "$world/world.mt" && rm -f "$world/world.mt.bak"
	jq -r '.enable[] | "load_mod_\(.) = true"' <<<"$install_json" >>"$world/world.mt"
	info "serving $(basename "$path") in $game on 127.0.0.1:$port; world: $world"
	info "connect with the Luanti client (Join Game -> 127.0.0.1 : $port); Ctrl-C to stop"
	LUANTI_GAME_PATH="$(dirname "$gdir")" MINETEST_GAME_PATH="$(dirname "$gdir")" \
		LUANTI_MOD_PATH="$mods" MINETEST_MOD_PATH="$mods" \
		exec "$bin" --server --world "$world" --gameid "$id" --port "$port"
}

# ---------------------------------------------------------------- contentdb

cdb_usage() {
	cat <<'EOF'
Usage: avanti cdb status [PATH|AUTHOR/NAME] [--json]
       avanti cdb release REF [PATH|AUTHOR/NAME] [--title TITLE] [--notes-file FILE] [--timeout SECONDS]
       avanti cdb release VERSION [PATH|AUTHOR/NAME] --zip FILE [--notes-file FILE] [--timeout SECONDS]
       avanti cdb whoami

status   Package state on ContentDB, latest release, game support and maintainers. With a PATH
         (default .) it also checks that the latest release matches a local git tag. Read-only.
release  Create a release from the git ref REF (a pushed tag such as v1.2.0) and wait until
         ContentDB has imported it. Needs CONTENTDB_TOKEN. Not needed with a release webhook.
         With --zip, upload FILE instead (for packages inside a monorepo, which ContentDB's git
         import can't reach); VERSION becomes the release title.
whoami   Check CONTENTDB_TOKEN; prints the user name only.

The package is AUTHOR/NAME, or NAME from PATH's mod.conf/modpack.conf/game.conf with AUTHOR
from AVANTI_CONTENTDB_USER (else from the token).
EOF
}

# Name declared in a package's .conf, else the folder name.
package_name() {
	local conf value
	for conf in mod.conf modpack.conf game.conf; do
		[[ -f "$1/$conf" ]] || continue
		value="$(awk -F'=' '/^[[:space:]]*name[[:space:]]*=/ { gsub(/[[:space:]]/, "", $2); print $2; exit }' "$1/$conf")"
		[[ -n "$value" ]] && echo "$value" && return 0
	done
	basename "$1"
}

cdb_whoami() { CDB_AUTH=1 cdb_get /api/whoami/ | jq -r '.username // empty'; }

# cdb_target <PATH|AUTHOR/NAME>: sets CDB_PKG (author/name) and CDB_PATH (local dir or empty).
cdb_target() {
	local arg="$1" author="${AVANTI_CONTENTDB_USER:-}"
	CDB_PATH=""
	if [[ "$arg" == */* && ! -d "$arg" ]]; then
		CDB_PKG="$arg"
		return 0
	fi
	[[ -d "$arg" ]] || die "no such directory: $arg"
	CDB_PATH="$(cd "$arg" && pwd)"
	if [[ -z "$author" && -n "${CONTENTDB_TOKEN:+set}" ]]; then author="$(cdb_whoami)" || true; fi
	[[ -n "$author" ]] || die "unknown ContentDB author: set AVANTI_CONTENTDB_USER or pass AUTHOR/NAME"
	CDB_PKG="$author/$(package_name "$CDB_PATH")"
}

cdb_status() {
	local target="." json=0 package releases
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--json) json=1; shift ;;
		-h | --help) cdb_usage; return 0 ;;
		-*) die "unknown option $1" ;;
		*) target="$1"; shift ;;
		esac
	done
	cdb_target "$target"
	if ! package="$(cdb_get "/api/packages/$CDB_PKG/" 2>/dev/null)"; then
		if [[ "$(jq -r '.code // empty' <<<"$package" 2>/dev/null)" == 404 ]]; then
			if [[ $json -eq 1 ]]; then
				jq -n --arg pkg "$CDB_PKG" '{package: $pkg, exists: false}'
			else
				info "$CDB_PKG is not on ContentDB yet. The first release is made on the website (see the contentdb-publishing skill)."
			fi
			return 0
		fi
		die "ContentDB request failed for $CDB_PKG: $(jq -r '.description // empty' <<<"$package" 2>/dev/null)"
	fi
	releases="$(cdb_get "/api/packages/$CDB_PKG/releases/")" || die "ContentDB request failed for $CDB_PKG releases"

	# The local tag for the latest release: its name or title, with or without a leading v.
	local latest_name latest_commit tag="" tag_commit="" candidate
	latest_name="$(jq -r '.[0].name // empty' <<<"$releases")"
	latest_commit="$(jq -r '.[0].commit // empty' <<<"$releases")"
	if [[ -n "$CDB_PATH" && -n "$latest_name" ]] && git -C "$CDB_PATH" rev-parse --git-dir >/dev/null 2>&1; then
		for candidate in "$latest_name" "v$latest_name" "${latest_name#v}" \
			"$(jq -r '.[0].title' <<<"$releases")"; do
			if tag_commit="$(git -C "$CDB_PATH" rev-parse -q --verify "refs/tags/$candidate^{commit}" 2>/dev/null)"; then
				tag="$candidate"
				break
			fi
		done
	fi

	if [[ $json -eq 1 ]]; then
		jq -n --argjson p "$package" --argjson r "$releases" --arg tag "$tag" --arg tag_commit "$tag_commit" \
			--arg url "$AVANTI_CONTENTDB_URL/packages/$CDB_PKG/" \
			'{package: "\($p.author)/\($p.name)", exists: true, url: $url, state: $p.state, type: $p.type,
			  maintainers: $p.maintainers, supports_all_games: $p.supports_all_games,
			  game_support: [$p.game_support[] | {game: "\(.game.author)/\(.game.name)", supports, confidence}],
			  releases: ($r | length), latest_release: ($r[0] // null | if . then del(.url) else . end),
			  local_tag: (if $tag == "" then null else {name: $tag, commit: $tag_commit} end)}'
		return 0
	fi

	local tag_line="no matching local tag"
	if [[ -z "$CDB_PATH" ]]; then
		tag_line=""
	elif [[ -n "$tag" && -z "$latest_commit" ]]; then
		tag_line="local tag $tag"
	elif [[ -n "$tag" && "$tag_commit" == "$latest_commit" ]]; then
		tag_line="${C_GREEN}matches local tag $tag${C_OFF}"
	elif [[ -n "$tag" ]]; then
		tag_line="${C_YELLOW}local tag $tag is at ${tag_commit:0:7}${C_OFF}"
	fi
	jq -r --argjson r "$releases" --arg url "$AVANTI_CONTENTDB_URL/packages/$CDB_PKG/" --arg tag_line "$tag_line" '
		def games: if .supports_all_games then "all games"
			elif (.game_support | length) == 0 then "none recorded"
			else [.game_support[] | "\(.game.name)\(if .supports then "" else " (unsupported)" end)"] | join(", ") end;
		"\(.author)/\(.name)  \(.state)  (\(.type))",
		"  latest release  " + (if ($r | length) == 0 then "none"
			else ($r[0] | "\(.title)  \(.release_date[:10])  \((.commit // "")[:7])") + (if $tag_line == "" then "" else "  " + $tag_line end) end),
		"  releases        \($r | length)",
		"  games           \(games)",
		"  maintainers     \(.maintainers | join(", "))",
		"  url             \($url)"' <<<"$package"
}

cdb_release() {
	local ref="" target="." title="" notes="" limit=300 zip="" body response task release_id
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--title) title="$2"; shift 2 ;;
		--zip) zip="$2"; shift 2 ;;
		--notes-file) notes="$2"; shift 2 ;;
		--timeout) limit="$2"; shift 2 ;;
		-h | --help) cdb_usage; return 0 ;;
		-*) die "unknown option $1" ;;
		*) if [[ -z "$ref" ]]; then ref="$1"; else target="$1"; fi; shift ;;
		esac
	done
	[[ -n "$ref" ]] || die "avanti cdb release REF [PATH|AUTHOR/NAME]: REF is the pushed git tag, e.g. v1.2.0"
	[[ -z "$notes" || -f "$notes" ]] || die "no such file: $notes"
	[[ -n "${CONTENTDB_TOKEN:+set}" ]] ||
		die "CONTENTDB_TOKEN is not set: create a token scoped to the package at $AVANTI_CONTENTDB_URL/user/tokens/"
	cdb_target "$target"
	if [[ -n "$zip" ]]; then
		[[ -f "$zip" ]] || die "no such file: $zip"
		note "uploading $(basename "$zip") as release ${title:-${ref#v}} of $CDB_PKG"
		if ! response="$(cdb_upload "/api/packages/$CDB_PKG/releases/new/" "$zip" "${title:-${ref#v}}" "$notes")"; then
			die "ContentDB refused the release: $(jq -r '.error // .description // .' <<<"$response" 2>/dev/null)"
		fi
	else
		body="$(jq -n --arg ref "$ref" --arg name "${ref#v}" --arg title "${title:-${ref#v}}" \
			--rawfile notes "${notes:-/dev/null}" \
			'{method: "git", ref: $ref, name: $name, title: $title} + (if $notes == "" then {} else {release_notes: $notes} end)')"
		note "creating release ${ref#v} of $CDB_PKG from $ref"
		if ! response="$(CDB_AUTH=1 cdb_request POST "/api/packages/$CDB_PKG/releases/new/" "$body")"; then
			die "ContentDB refused the release: $(jq -r '.error // .description // .' <<<"$response" 2>/dev/null)"
		fi
	fi
	task="$(jq -r '.task // empty' <<<"$response")"
	release_id="$(jq -r '.release.id // empty' <<<"$response")"
	if [[ -z "$task" && -n "$zip" && "$(jq -r '.success // empty' <<<"$response")" == true ]]; then
		info "${C_GREEN}released${C_OFF} ${title:-${ref#v}} (release ${release_id:-?})"
		echo "$AVANTI_CONTENTDB_URL/packages/$CDB_PKG/"
		return 0
	fi
	[[ -n "$task" ]] || die "unexpected response from ContentDB: $response"

	# ContentDB imports the release in a background task; wait for it to finish.
	local started status="" task_json
	started=$(date +%s)
	while (($(date +%s) - started < limit)); do
		task_json="$(cdb_get "$task")" || task_json='{}'
		status="$(jq -r '.status // empty' <<<"$task_json")"
		case "$status" in
		SUCCESS)
			info "${C_GREEN}released${C_OFF} ${ref#v} (release $release_id)"
			echo "$AVANTI_CONTENTDB_URL/packages/$CDB_PKG/"
			return 0
			;;
		FAILURE | REVOKED)
			info "${C_RED}import failed${C_OFF}: $(jq -r '.error // "no details"' <<<"$task_json")"
			info "details and the package thread: $AVANTI_CONTENTDB_URL/packages/$CDB_PKG/"
			return 1
			;;
		esac
		sleep 3
	done
	warn "the import is still ${status:-pending} after ${limit}s; check $AVANTI_CONTENTDB_URL$task"
	return 2
}

cmd_cdb() {
	local sub="${1:-}"
	shift || true
	have jq || die "jq is required"
	case "$sub" in
	status) cdb_status "$@" ;;
	release) cdb_release "$@" ;;
	whoami)
		local user
		[[ -n "${CONTENTDB_TOKEN:+set}" ]] ||
			die "CONTENTDB_TOKEN is not set: create a token at $AVANTI_CONTENTDB_URL/user/tokens/"
		user="$(cdb_whoami)" || die "ContentDB request failed"
		[[ -n "$user" ]] || die "CONTENTDB_TOKEN is not valid"
		echo "$user"
		;;
	-h | --help | help | "") cdb_usage ;;
	*) cdb_usage; exit 1 ;;
	esac
}

# ---------------------------------------------------------------- screenshot

screenshot_usage() {
	cat <<'USAGE'
Usage: avanti screenshot [PATH] [--game ID]... [--shots FILE] [--out DIR] [--size WxH] [--seed SEED] [--gif]
       avanti screenshot [PATH] --record --game ID [--shots FILE]

Renders the mod in the real Luanti client and captures only the Luanti window (macOS, needs
the Luanti app and Xcode command line tools for swiftc).

Scene: the mod's own tools/showcase mod (builds the scene on join and may call
avanti_camera.scene_ready()), else a generic showcase that lines up the mod's nodes on a
daylit platform (tool-only mods are shown in hand).

Shots: PATH/screenshots/shots.json (or --shots FILE) lists camera positions, directions, time
of day and FOV; all of them are taken in one engine start per game and written to
DIR/<game>-<name>.png. Without a shot list there is one shot with the scene's own camera,
written to DIR/<game>.png. The world seed is fixed (--seed, default "avanti") so recorded
positions stay valid.

Videos: a shot with "keys" (camera keyframes with t in seconds) or "orbit" (center, radius,
height, turns) is rendered frame by frame along a smooth path and written to
DIR/<game>-<name>.mp4 (H.264, --size, the shot's fps, default 30); --gif adds a 600 px GIF.
Rendering is lockstep (move camera, wait for the frame, capture), so it runs slower than real
time but every frame is exact.

--record opens the game interactively in the same world: fly to a spot (K), set the time with
/time, type /shot <name> for a still or /key <video> [seconds] for each keyframe of a video
(/preview <video> plays it, /unkey <video> drops the last key); /shots lists them. Quitting
merges them into the shot list.

DIR defaults to PATH/screenshots; images are 1500x1000 (3:2, as ContentDB wants), and
PATH/screenshot.png (600x400) is created if the mod has none. Games default to
supported_games in mod.conf, else minetest. The client window is visible while it runs.
USAGE
}

# helper_bin <name>: compile lib/screenshot/<name>.swift once into $AVANTI_HOME/bin.
helper_bin() {
	local src="$AVANTI_LIB/screenshot/$1.swift" bin="$AVANTI_HOME/bin/$1"
	if [[ ! -x "$bin" || "$src" -nt "$bin" ]]; then
		have swiftc || die "swiftc is needed (xcode-select --install)"
		mkdir -p "$AVANTI_HOME/bin"
		swiftc -O "$src" -o "$bin" >/dev/null || die "could not compile $src"
	fi
	echo "$bin"
}

# screenshot_world <path> <game> <run> <mode> <shots> <seed> <width> <height>: mods, world, config.
screenshot_world() {
	local path="$1" game="$2" run="$3" mode="$4" shots="$5" seed="$6" width="$7" height="$8"
	local id showcase
	id="$(game_id "$game")"
	mkdir -p "$run/mods" "$run/world" "$run/user"
	rsync -a --exclude .git --exclude .github --exclude screenshots --exclude tools "$path/" "$run/mods/$PKG_FOLDER/"
	ldg install "$path" --game "$game" --dest "$run/mods" --json >"$run/install.json" ||
		die "dependencies can't be met in $game (ldg resolve $path --game $game)"
	if [[ -f "$path/tools/showcase/mod.conf" ]]; then
		showcase="$(awk -F'=' '/^[[:space:]]*name[[:space:]]*=/ { gsub(/[[:space:]]/, "", $2); print $2 }' "$path/tools/showcase/mod.conf")"
		cp -R "$path/tools/showcase" "$run/mods/$showcase"
	else
		showcase="avanti_showcase"
		cp -R "$AVANTI_LIB/avanti_showcase" "$run/mods/"
	fi
	cp -R "$AVANTI_LIB/avanti_camera" "$run/mods/"
	{
		echo "gameid = $id"
		echo "backend = sqlite3"
		echo "creative_mode = true"
		echo "enable_damage = false"
		jq -r '.enable[] | "load_mod_\(.) = true"' "$run/install.json"
		echo "load_mod_$showcase = true"
		echo "load_mod_avanti_camera = true"
	} >"$run/world/world.mt"
	[[ -f "$shots" ]] && cp "$shots" "$run/world/avanti_shots.json"
	{
		echo "screen_w = $width"
		echo "screen_h = $height"
		echo "fullscreen = false"
		echo "enable_minimap = false"
		echo "show_debug = false"
		echo "viewing_range = 100"
		echo "creative_mode = true"
		echo "enable_damage = false"
		echo "name = singleplayer"
		echo "smooth_lighting = true"
		echo "fixed_map_seed = $seed"
		echo "avanti_showcase = true"
		echo "avanti_showcase_mods = ${TARGET_MODS// /,}"
		echo "avanti_camera_mode = $mode"
		if [[ "$mode" == replay ]]; then
			echo "node_highlighting = none"
			echo "crosshair_alpha = 0"
			echo "dedicated_server_step = 0.02" # faster camera/capture handshake, ~10 video frames/s
		fi
	} >"$run/client.conf"
}

# screenshot_launch <game> <run>: start the client in the background, sets SHOT_PID.
screenshot_launch() {
	local gdir id bin
	gdir="$(game_dir "$1")"
	id="$(game_id "$1")"
	bin="$(luanti_bin)" || die "no Luanti app found (brew install --cask luanti)"
	LUANTI_GAME_PATH="$(dirname "$gdir")" MINETEST_GAME_PATH="$(dirname "$gdir")" \
		LUANTI_MOD_PATH="$2/mods" LUANTI_USER_PATH="$2/user" \
		"$bin" --go --world "$2/world" --gameid "$id" --config "$2/client.conf" \
		--logfile "$2/client.log" >"$2/client.out" 2>&1 &
	SHOT_PID=$!
}

# screenshot_window <run>: wait for the Luanti window and print its id.
screenshot_window() {
	local winid wid=""
	winid="$(helper_bin winid)"
	for _ in $(seq 1 60); do
		sleep 1
		wid="$("$winid" luanti || true)"
		[[ -n "$wid" ]] && break
		kill -0 "$SHOT_PID" 2>/dev/null || break
	done
	if [[ -z "$wid" ]]; then
		kill "$SHOT_PID" 2>/dev/null || true
		grep -q "Could not create window" "$1/client.log" 2>/dev/null &&
			die "Luanti couldn't open a window. Run avanti screenshot from a normal terminal (sandboxed shells, e.g. an agent's, have no GUI access)."
		die "no Luanti window appeared; see $1/client.log"
	fi
	echo "$wid"
}

# screenshot_replay <path> <game> <out_dir> <shots> <seed> <width> <height> <timeout> <gif:0|1>
screenshot_replay() {
	local path="$1" game="$2" out="$3" shots="$4" seed="$5" width="$6" height="$7" limit="$8" gif="$9"
	local folder run wid cropbottom winvideo elapsed=0 done_shots=0 line idx name file gif_file dups
	[[ -n "$(game_dir "$game")" ]] || { warn "game $game not synced (avanti games sync $game), skipped"; return 0; }
	folder="$(game_field "$game" 2)"
	folder="${folder:-$game}"
	cropbottom="$(helper_bin cropbottom)"
	winvideo="$(helper_bin winvideo)"
	run="$(mktemp -d "${TMPDIR:-/tmp}/avanti-shot.XXXXXX")"
	screenshot_world "$path" "$game" "$run" replay "$shots" "$seed" "$width" "$height"
	screenshot_launch "$game" "$run"
	wid="$(screenshot_window "$run")"
	local cw=$((width - 36))
	local ch=$((cw * height / width))
	while ((elapsed < limit)); do
		line="$(grep -E "\[avanti_camera\] (READY|VIDEO|DONE)" "$run/client.log" 2>/dev/null | tail -1 || true)"
		if [[ "$line" == *DONE* ]]; then
			break
		elif [[ "$line" =~ VIDEO\ ([0-9]+)\ ([0-9]+)\ ([0-9]+)\ (.*)$ ]] && ((BASH_REMATCH[1] > done_shots)); then
			idx="${BASH_REMATCH[1]}"
			name="${BASH_REMATCH[4]}"
			file="$out/$folder-$name.mp4"
			gif_file=""
			[[ "$gif" == 1 ]] && gif_file="$out/$folder-$name.gif"
			note "recording $name: ${BASH_REMATCH[2]} frames at ${BASH_REMATCH[3]} fps"
			if dups="$("$winvideo" "$wid" "$run/client.log" "$run/world/avanti_camera_frame_ack" "$idx" "$file" \
				"$width" "$height" "$gif_file")"; then
				info "${C_GREEN}wrote${C_OFF} $file${gif_file:+ and $gif_file}"
				[[ -n "$dups" ]] && warn "$name: ${dups#duplicates } frame(s) look identical to the previous one (the camera may not have moved, or try a higher avanti_camera_frame_wait)"
			else
				warn "recording $name failed; see $run/client.log"
				break
			fi
			done_shots="$idx"
			continue
		elif [[ "$line" =~ READY\ ([0-9]+)\ (.*)$ ]] && ((BASH_REMATCH[1] > done_shots)); then
			idx="${BASH_REMATCH[1]}"
			name="${BASH_REMATCH[2]}"
			if [[ -f "$shots" ]]; then file="$out/$folder-$name.png"; else file="$out/$folder.png"; fi
			screencapture -x -o -l"$wid" "$file"
			# Drop the title bar and the rounded window corners, keep the aspect ratio, scale back.
			"$cropbottom" "$file" "$file" "$cw" "$ch" 18
			sips -z "$height" "$width" "$file" >/dev/null
			info "${C_GREEN}wrote${C_OFF} $file"
			done_shots="$idx"
			echo "$idx" >"$run/world/avanti_camera_ack"
			[[ -z "$SHOT_FIRST" ]] && SHOT_FIRST="$file"
		fi
		sleep 0.5
		elapsed=$((elapsed + 1))
	done
	((elapsed < limit)) || warn "timed out in $game after $((limit / 2))s; see $run/client.log"
	kill "$SHOT_PID" 2>/dev/null || true
	wait "$SHOT_PID" 2>/dev/null || true
	((elapsed < limit)) && rm -rf "$run"
	return 0
}

# screenshot_record <path> <game> <shots> <seed> <width> <height>
screenshot_record() {
	local path="$1" game="$2" shots="$3" seed="$4" width="$5" height="$6" run
	[[ -n "$(game_dir "$game")" ]] || die "game $game not synced (avanti games sync $game)"
	run="$(mktemp -d "${TMPDIR:-/tmp}/avanti-record.XXXXXX")"
	screenshot_world "$path" "$game" "$run" record "$shots" "$seed" "$width" "$height"
	info "Record mode: fly to a spot (K), set the time with /time, then /shot <name>. Quit Luanti when done."
	screenshot_launch "$game" "$run"
	screenshot_window "$run" >/dev/null
	wait "$SHOT_PID" 2>/dev/null || true
	if [[ ! -f "$run/world/avanti_shots.json" ]]; then
		warn "no shots recorded"
		return 0
	fi
	mkdir -p "$(dirname "$shots")"
	if [[ -f "$shots" ]]; then # merge by name: recorded shots replace existing ones
		jq -s '{shots: ((.[0].shots // []) + (.[1].shots // []) | group_by(.name) | map(.[-1]))}' \
			"$shots" "$run/world/avanti_shots.json" >"$run/merged.json"
		mv "$run/merged.json" "$shots"
	else
		cp "$run/world/avanti_shots.json" "$shots"
	fi
	info "${C_GREEN}saved${C_OFF} $(jq '.shots | length' "$shots") shot(s) to $shots; take them with: avanti screenshot $path"
	rm -rf "$run"
}

cmd_screenshot() {
	local path="." out="" size="1500x1000" seed="avanti" shots="" record=0 gif=0 games=()
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--game) games+=("$2"); shift 2 ;;
		--out) out="$2"; shift 2 ;;
		--size) size="$2"; shift 2 ;;
		--seed) seed="$2"; shift 2 ;;
		--shots) shots="$2"; shift 2 ;;
		--record) record=1; shift ;;
		--gif) gif=1; shift ;;
		-h | --help) screenshot_usage; return 0 ;;
		-*) die "unknown option $1" ;;
		*) path="$1"; shift ;;
		esac
	done
	[[ "$(uname -s)" == Darwin ]] || die "avanti screenshot currently needs macOS (it drives the Luanti app and captures its window)"
	path="$(cd "$path" && pwd)"
	out="${out:-$path/screenshots}"
	shots="${shots:-$path/screenshots/shots.json}"
	[[ "$shots" == /* ]] || shots="$PWD/$shots"
	TARGET_MODS="$(ldg deps "$path" --json | jq -r '.provides | join(" ")')"
	[[ -n "$TARGET_MODS" ]] || die "no mods found in $path"
	PKG_FOLDER="$(basename "$path")"
	if [[ -f "$path/init.lua" && "$TARGET_MODS" != *" "* ]]; then PKG_FOLDER="$TARGET_MODS"; fi
	if [[ ${#games[@]} -eq 0 ]]; then
		while IFS= read -r g; do games+=("$g"); done < <(declared_games "$path")
		[[ ${#games[@]} -gt 0 ]] || games=(minetest)
	fi
	if [[ $record -eq 1 ]]; then
		screenshot_record "$path" "${games[0]}" "$shots" "$seed" "${size%x*}" "${size#*x}"
		return 0
	fi
	mkdir -p "$out"
	local count=1
	[[ -f "$shots" ]] && count="$(jq '.shots | length' "$shots")"
	SHOT_FIRST=""
	local g
	for g in "${games[@]}"; do
		note "rendering $(basename "$path") in $g ($count shot(s))"
		# timeout in half-second polls: startup plus ~20 s per shot
		screenshot_replay "$path" "$g" "$out" "$shots" "$seed" "${size%x*}" "${size#*x}" $(((60 + 20 * count) * 2)) "$gif"
	done
	if [[ -n "$SHOT_FIRST" && ! -f "$path/screenshot.png" ]]; then
		sips -z 400 600 "$SHOT_FIRST" --out "$path/screenshot.png" >/dev/null
		info "${C_GREEN}wrote${C_OFF} $path/screenshot.png (600x400, shown by the in-game content manager)"
	fi
}

cmd_env() {
	cat <<EOF
AVANTI_HOME=$AVANTI_HOME
AVANTI_CORPUS=$AVANTI_CORPUS
AVANTI_GAMES=$AVANTI_GAMES
AVANTI_ENGINE_VERSION=$AVANTI_ENGINE_VERSION
AVANTI_PLUGIN_ROOT=$AVANTI_PLUGIN_ROOT
AVANTI_PACKAGES=$AVANTI_PACKAGES
AVANTI_SEARCH=$AVANTI_SEARCH
LDG_HOME=${LDG_HOME:-(ldg default)}
EOF
}

main() {
	local cmd="${1:-help}"
	shift || true
	case "$cmd" in
	doctor) cmd_doctor "$@" ;;
	games) cmd_games "$@" ;;
	corpus) [[ "${1:-}" == sync ]] && shift; cmd_corpus "$@" ;;
	new) cmd_new "$@" ;;
	test) cmd_test "$@" ;;
	serve) cmd_serve "$@" ;;
	screenshot) cmd_screenshot "$@" ;;
	index) cmd_index "$@" ;;
	cdb) cmd_cdb "$@" ;;
	env) cmd_env ;;
	help | -h | --help) usage ;;
	*) usage; exit 1 ;;
	esac
}

main "$@"
